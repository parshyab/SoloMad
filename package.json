{
  "name": "solomad",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @solomad/api --filter @solomad/realtime --filter @solomad/worker --filter @solomad/admin --filter @solomad/web dev",
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" exec tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter @solomad/web exec playwright test --config ../../tests/e2e/playwright.config.ts",
    "load:smoke": "node tests/load/smoke.mjs",
    "db:migrate": "pnpm --filter @solomad/db migrate",
    "db:seed": "pnpm --filter @solomad/db seed",
    "verify:release": "node scripts/verify-release.mjs",
    "openapi:check": "node scripts/check-openapi.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
