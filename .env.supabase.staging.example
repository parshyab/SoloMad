# Hosted staging Supabase values. Copy to .env.supabase.staging.local and fill there.
# That file is gitignored. Do not put real values in this example.
# SUPABASE_SMOKE_EMAIL and SUPABASE_SMOKE_PASSWORD are a dedicated user in this
# project's Supabase Auth, not the Supabase dashboard login.
# API_PUBLIC_ORIGIN and REALTIME_PUBLIC_ORIGIN are this app's deployed API and
# gateway. They are not derived from SUPABASE_URL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SMOKE_EMAIL=
SUPABASE_SMOKE_PASSWORD=
API_PUBLIC_ORIGIN=
REALTIME_PUBLIC_ORIGIN=
