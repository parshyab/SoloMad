# Public vs secret: values below are names only. Do not commit real secrets.
# Copy to .env for local development. Bootstrap fills local-only defaults.

APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info

# supabase | development | test
# make dev runs the API and gateway with AUTH_MODE=supabase against the local Supabase CLI stack;
# its values come from .env.supabase.local (written by make supabase-start, gitignored).
# AUTH_MODE=development (DEV_AUTH_SECRET tokens) remains for backend-only scripts.
# staging and production require AUTH_MODE=supabase with a hosted https project and reject local endpoints.
AUTH_MODE=development
DEV_AUTH_SECRET=replace-with-local-random
TEST_AUTH_SECRET=replace-with-test-random
# Public: hosted project URL and publishable key (the only Supabase values allowed in iOS).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key, used for ban/deletion checks. Never in the app, logs, or Git.
SUPABASE_SECRET_KEY=
# Optional overrides; default to ${SUPABASE_URL}/auth/v1, "authenticated", and the project JWKS.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
# How long a confirmed session is trusted before re-checking logout/ban/deletion (0-300 seconds).
SUPABASE_SESSION_CHECK_TTL_SECONDS=30
# Local Supabase CLI only: Google OAuth web-client credentials. Do not copy the
# secret to iOS or a client-side configuration file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Hosted live smoke only (make supabase-live-smoke): an owner-created test account in the hosted project.
SUPABASE_SMOKE_EMAIL=
SUPABASE_SMOKE_PASSWORD=

DATABASE_URL=postgres://solomad:solomad@127.0.0.1:5432/solomad
REDIS_URL=redis://127.0.0.1:6379

API_HOST=0.0.0.0
API_PORT=3000
REALTIME_PORT=3001
WORKER_PORT=3002
ADMIN_PORT=3010
WEB_PORT=3020

# Simulator can use 127.0.0.1. A physical iPhone must use the computer's LAN IP.
API_PUBLIC_ORIGIN=http://127.0.0.1:3000
REALTIME_PUBLIC_ORIGIN=http://127.0.0.1:3001
SHARE_HOST=localhost:3020
WEB_ORIGIN=http://127.0.0.1:3020
ADMIN_ORIGIN=http://127.0.0.1:3010
CORS_ORIGINS=http://127.0.0.1:3010,http://127.0.0.1:3020

MEDIA_PROVIDER=local
MEDIA_LOCAL_DIR=var/media
S3_BUCKET=solomad-media-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
CDN_PUBLIC_BASE_URL=

QUEUE_PROVIDER=database
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_REGION=us-east-1
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_DAILY_QUOTA_FREE=3
AI_DAILY_QUOTA_PLUS=30
AI_GLOBAL_DAILY_TOKEN_BUDGET=200000

REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
REVENUECAT_PUBLIC_SDK_KEY=

APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=app.solomad.ios
APPLE_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox

ADMIN_EMAIL=admin@solomad.invalid
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CITY_ROOM_MEMBER_LIMIT=500
PARTNERS_URL=https://solomad.app/partners
LEGAL_CONTACT_EMAIL=privacy@solomad.invalid
LEGAL_STATUS=draft

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=noreply@solomad.invalid
